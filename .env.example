# Copy this file to .env and adjust as needed. The app runs fine with these defaults.

# Port the Express API listens on
PORT=3001

# Path of the SQLite database file (created automatically)
DATABASE_PATH=./data/gems-and-rackets.db

# Password for the admin dashboard login — set your own before the pilot
ADMIN_PASSWORD=change-me

# The club's MTN MoMo number members send payments to, and the name they
# should see on the transfer. Shown on the payment instructions.
CLUB_MOMO_NUMBER=0700 000000
CLUB_MOMO_NAME=Gems & Rackets

